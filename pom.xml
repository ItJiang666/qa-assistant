<?xml version="1.0" encoding="UTF-8"?>
<!--
  qa-assistant · 可离线运行的知识库智能问答助手
  ============================================================================
  设计依据：《智能问答助手-开发文档 v1.4》
  关键取舍（详见文档，勿随意改动）：
    · java.version = 17 —— 不是 25。Spring Boot 4.1.1 官方最低要求即 Java 17，
      只有把编译目标压到 17 才能让产物在 17/21/25/26 上都能跑（文档 3.4）。
      本机仍用 JDK 25 编译，parent 会把 java.version 映射到 maven.compiler.release。
    · 默认数据源 H2 文件库，MySQL 作为可选 profile（决策 15）。
      用 MariaDB 驱动而非 MySQL Connector/J，规避 GPL 授权歧义（文档 12.4）。
    · LangChain4j 锁 1.20.2（决策 20）：与文档初稿同一 minor，只吃补丁修复。
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.itjiang</groupId>
    <artifactId>qa-assistant</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>qa-assistant</name>
    <description>可离线运行的知识库智能问答助手：RAG 检索问答 + 三层记忆体系</description>

    <properties>
        <!-- ★ 编译目标 17，不要改成 25（文档 3.4） -->
        <java.version>17</java.version>
        <!-- 显式声明一遍：source/target 不校验 API，release 才校验，这是关键 -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- source/target 仅为让 IntelliJ 推导模块语言级别；Maven 实际编译仍以 release=17 为准 -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 依赖版本集中管理，便于一处升级 -->
        <langchain4j.version>1.20.2</langchain4j.version>
        <!-- Spring Boot 4 starter 走独立的 beta 版本号线，与核心版本同前缀 -->
        <langchain4j.starter.version>1.20.2-beta30</langchain4j.starter.version>
        <mybatis.starter.version>4.1.0</mybatis.starter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j 核心模块版本由 BOM 统一管理；
                 注意 BOM 不管 spring-boot4-starter，那些必须单独写版本 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ── Web：Spring MVC + SseEmitter（流式输出不引入 WebFlux）── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── 参数校验：Jakarta Validation ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── 持久化 ── -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.starter.version}</version>
        </dependency>
        <!-- 默认数据库：H2 文件模式，零安装即可跑 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 可选数据库：MySQL 8（用 MariaDB 驱动连接，协议兼容且授权更宽松） -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── LangChain4j：核心 + Ollama 实现 + Spring Boot 4 装配 ── -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>
        <!--
          文档解析：Tika 一份依赖覆盖 txt / md / docx / pdf / xlsx / html（开发文档 3.2）。
          ⚠️ 版本号要写 beta 线：这个模块不在 langchain4j-bom 的管理范围内，
             它跟随 starter 的版本（1.20.2-beta30）。写 1.20.2 会直接拉不到 ——
             已验证 Maven Central 上只有 1.20.0-beta30 / 1.20.1-beta30 / 1.20.2-beta30 这一串。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-tika</artifactId>
            <version>${langchain4j.starter.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot4-starter</artifactId>
            <version>${langchain4j.starter.version}</version>
        </dependency>
        <!--
          刻意不引入 langchain4j-ollama-spring-boot4-starter：
          它会在 classpath 上自动创建 ChatModel / EmbeddingModel Bean，而本项目是双模式设计
          （qa.mode 决定用本地还是云端），模型必须由 com.itjiang.qa.config.ModelConfig 显式装配。
          两者的 Bean 会互相干扰，且自动装配的模型拿不到 num_ctx 等关键参数。
          @AiService 所需的能力由上面的 langchain4j-spring-boot4-starter 提供，够用。
        -->

        <!-- ── 测试 ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 打包成可执行 fat jar：java -jar 即可运行（文档 12.5 最推荐的分发形态） -->
                    <mainClass>com.itjiang.qa.QaApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

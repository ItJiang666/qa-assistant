# =============================================================================
# qa-assistant 环境变量样例
#
# 用法：复制这份文件为 .env，按需填写。
#   cp .env.example .env          （Windows: copy .env.example .env）
#
# 程序会**自动读取项目根目录的 .env**（见 application.yml 的 spring.config.import）。
# 注意事项：
#   1. .env 已被 .gitignore 排除，绝不会被提交（开发文档 12.4 红线之一）
#   2. 路径相对**工作目录**：IDEA 默认项目根；java -jar 则以启动目录为根
#   3. .env 的值优先级高于 application.yml 的默认值 —— 排查"配置改了没生效"先看这里
#
# 只用本地 Ollama 时，本文件**全部留空也能跑** —— 不需要任何 API Key。
# =============================================================================

# ── 模型来源（P4 起：与 profile 无关）─────────────────────────────────────
# QA_PROFILES **只管数据源**（h2 / mysql）。模型用本地还是云端由 qa.mode 决定，
# 并且可以在界面上运行时切换（重启后回到 qa.mode 的值）。
QA_PROFILES=h2,local

# qa.mode 的启动默认值：local（默认，零配置）| cloud（需要下面的 Key）
QA_MODE=local

# ── 运行时数据目录 ────────────────────────────────────────────────────────
# 默认 ${user.home}/.qa-assistant，内含 data(H2) / uploads(上传原件) / index(向量落盘)
# 想整体搬到 D 盘就取消注释：
# QA_DATA_DIR=D:/qa-data

# ── 云端模型的 API Key ────────────────────────────────────────────────────
# 只填要用的那个即可；没填的 Key 不影响本地模式启动。
# ⚠️ Key 只从环境变量读，仓库与数据库里都不落密钥（开发文档 12.4 红线）。
#    界面上只显示"已配置 / 未配置"，不回显内容。
#
# ⚠️⚠️ 请先看这一行，它是最容易踩的坑：
#     application.yml 里 **实际默认** 是「对话 DeepSeek + 向量阿里百炼」，
#     也就是说云端模式下**两个 Key 都要填**：
#         DEEPSEEK_API_KEY      （对话）
#         DASHSCOPE_API_KEY     （向量）
#     只填 DEEPSEEK_API_KEY 的症状是：能聊天，但**上传文件解析失败**
#     —— 因为分块之后要用向量模型做 embedding，那一步连不上就整条入库失败。
#     实测反馈过一次："embedding 连不上、chat 正常"，根因就是向量那侧没通。
#
# 对话：DeepSeek（api.deepseek.com，OpenAI 兼容）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停止，现役是 deepseek-flash
DEEPSEEK_API_KEY=

# 向量：阿里云百炼 DashScope 兼容模式（text-embedding-v4，1024 维）
# 为什么默认选它：可达性最稳。有用户反馈在别的机器上 api.siliconflow.cn 的 TLS
#   握手会被中间网络掐断（SSLHandshakeException: The remote host closed the handshake），
#   而同一台机器访问 api.deepseek.com 正常 —— 这是网络限制，不是 Key 的问题，
#   换 Key 解决不了，所以默认值必须挑一家容易连上的。
# ⚠️ 单次最多 10 条（超了报 batch size is invalid），已在 application.yml 里配好，不用改。
DASHSCOPE_API_KEY=

# 向量备选：硅基流动 SiliconFlow（Qwen/Qwen3-Embedding-4B，2560 维）
# 换过去要改两处：qa.cloud.embedding.provider=siliconflow 且
#                 model=Qwen/Qwen3-Embedding-4B、dimension=2560
# 好处：2560 维与本地 qa-embed:4b 同源同维，本地/云端互切**不需要重建索引**。
# ⚠️ 前提是那台机器能访问 api.siliconflow.cn。上面说的那种网络限制下它会一直失败，
#    且失败点在"入库"这一步，症状是上传文件解析失败（不是 401）。
# SILICONFLOW_API_KEY=

# ⚠️ 换向量厂商（包括本地 ↔ 云端互切）后**必须重建索引**：维度不同，旧向量用不了。
#    不重建不会静默出错，界面会明确报"向量索引与当前向量模型不匹配"，按提示重建即可。

# ── 其他内置厂商（可选）──────────────────────────────────────────────────
# 换厂商：改 qa.cloud.chat.provider / qa.cloud.embedding.provider，再填对应 Key。
# 完整清单、各家的模型与注意事项（**哪家不能作向量源**）看界面「系统状态 → 内置厂商」。
# ⚠️ 三家没有 embedding 接口（Kimi / MiniMax / 阶跃星辰），方舟的 embedding 不走
#    OpenAI 协议 —— 这四家只能当对话源，配成向量源必然失败。
# ZHIPU_API_KEY=          # 智谱 BigModel（GLM）：base-url 是 /api/paas/v4，不是 /v1
# MOONSHOT_API_KEY=       # 月之暗面 Kimi
# ARK_API_KEY=            # 火山方舟（豆包）
# HUNYUAN_API_KEY=        # 腾讯混元：embedding 维度固定 1024，不要传 dimensions
# MINIMAX_API_KEY=        # MiniMax
# STEP_API_KEY=           # 阶跃星辰 StepFun
# QIANFAN_API_KEY=        # 百度千帆 v2：鉴权是 Bearer（bce-v3/...），不是 AK/SK 签名

# ── MySQL（QA_PROFILES 含 mysql 时必填）──────────────────────────────────
MYSQL_USER=root
MYSQL_PASSWORD=

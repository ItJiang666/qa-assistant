# =============================================================================
# qa-assistant 环境变量样例
#
# 用法：复制这份文件为 .env，按需填写。
#   .env 已被 .gitignore 排除，绝不会被提交（开发文档 12.4 红线之一）。
#
# 只用本地 Ollama 时，本文件**全部留空也能跑** —— 不需要任何 API Key。
# =============================================================================

# ── 运行模式 ──────────────────────────────────────────────────────────────
# 两条正交的 Spring profile 轴，逗号分隔：
#   数据源： h2（默认，零安装）        | mysql（需本机已装 MySQL 8）
#   模型：   local（默认，本地 Ollama）| cloud（需下面的云端 Key）
QA_PROFILES=h2,local

# ── 运行时数据目录 ────────────────────────────────────────────────────────
# 默认 ${user.home}/.qa-assistant，内含 data(H2) / uploads(上传原件) / index(向量落盘)
# 想整体搬到 D 盘就取消注释：
# QA_DATA_DIR=D:/qa-data

# ── 云端模式（QA_PROFILES 含 cloud 时必填）────────────────────────────────
# 对话模型：DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=

# 向量模型：硅基流动 Qwen3-Embedding-4B
# 选它是因为与本地 qwen3-embedding:4b 同源同维（2560），切换不需要重建索引
SILICONFLOW_API_KEY=

# ── MySQL（QA_PROFILES 含 mysql 时必填）──────────────────────────────────
MYSQL_USER=root
MYSQL_PASSWORD=
